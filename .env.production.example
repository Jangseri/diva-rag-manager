# 서버 배포용 환경변수 템플릿
# 실제 배포 시 이 파일을 .env 로 복사 후 실제 값 입력:
#   cp .env.production.example .env
#
# <...> 부분은 신규 서버 IP/계정으로 반드시 교체하세요.
# 기존 운영 서버 값은 DEPLOY.md "사전 요구사항" 표를 참고.

# ========================
# Database (필수)
# ========================
# DB명은 extract_document 고정 (docs-extract-system과 공유)
# 비밀번호 특수문자는 URL 인코딩: ! -> %21, @ -> %40
DATABASE_URL="mysql://root:<비밀번호>@<DB_HOST>:3306/extract_document"

# ========================
# Redis Streams (필수)
# ========================
REDIS_URL="redis://<REDIS_HOST>:6379/0"

# ========================
# milvus-broker (검색 API, 필수)
# ========================
MILVUS_BROKER_URL="http://<BROKER_HOST>:8009"

# ========================
# extract-unstructured (URL 학습 HTTP API, 필수)
# ========================
EXTRACT_SERVICE_URL="http://<EXTRACT_HOST>:9005"

# ========================
# App (필수)
# ========================
# 브라우저에서 접속할 이 서버의 주소
NEXT_PUBLIC_APP_URL="http://<앱서버IP>:3000"

# 컨테이너 실행 uid:gid — 호스트에서 /data/diva 를 소유한 계정
# `id <계정명>` 으로 확인. 안 맞으면 파일 업로드가 권한 오류로 실패합니다.
APP_UID=1007
APP_GID=1012
